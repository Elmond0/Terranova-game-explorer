@using System.Globalization

<a href="gioco/@Game.Id" class="card-gioco">
	<MudCard Elevation="2" Class="altezza-piena">
		@if(Game.Image != null)
		{
			<img src="@Game.Image" alt="@Game.Name" loading="lazy" class="copertina"/>
		}
		else
		{
			<div class="copertina segnaposto">
				<MudIcon Icon="@Icons.Material.Filled.ImageNotSupported" Size="Size.Large">
				</MudIcon>
			</div>
		}
		<MudCardContent>
			<MudText Typo="Typo.subtitle1" Class="nome">
				@Game.Name
			</MudText>
			@if (EvidenziaData)
			{
				<MudText Typo="Typo.h6" Color="Color.Primary">
					@DataUscita
				</MudText>
			}
			else
			{
				<MudText Typo="Typo.body2" Class="mud-text-secondary">
					@DataUscita
				</MudText>
			}
			@if (Game.Rating > 0)
			{
				<MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
					<MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" Color="Color.Warning"/>
					<MudText Typo="Typo.body2">
						@Game.Rating.ToString("0.0")
					</MudText>
				</MudStack>
			}
			else
			{
				<MudText Typo="Typo.body2" Class="mud-text-secondary">
					Nessun voto
				</MudText>
			}
			@if (Famiglie.Count > 0)
			{
				<MudStack Row="true" Spacing="1" Class="mt-2">
					@foreach (var fam in Famiglie)
					{
						<MudTooltip Text="@fam">
							<MudIcon Icon="@IconaFamiglia(fam)" Size="Size.Small" Class="mud-text-secondary" aria-label="@fam">

							</MudIcon>
						</MudTooltip>
					}
				</MudStack>
			}
		</MudCardContent>
	</MudCard>
</a>

@code {
	[Parameter, EditorRequired]
	public Game Game { get; set; } = default!;

	[Parameter]
	public bool EvidenziaData { get; set; }

	private string DataUscita => Game.ReleaseDate is null ? "Data da annunciare" : Game.ReleaseDate.Value.ToString("d MMM yyyy", CultureInfo.GetCultureInfo("it-IT"));
	private static string NomeFamiglia(string slug)
	{
		if (slug.StartsWith("pc"))
			return "PC";
		else if (slug.StartsWith("playstation"))
			return "PlayStation";
		else if (slug.StartsWith("xbox"))
			return "Xbox";
		else if (slug.StartsWith("nintendo"))
			return "Nintendo";
		else if (slug.StartsWith("ios") || slug.StartsWith("android"))
			return "Mobile";
		else
			return "Altro";
	}
	private static string IconaFamiglia(string famiglia)
	{
		if (famiglia == "PC")
			return Icons.Material.Filled.DesktopWindows;
		else if (famiglia == "PlayStation")
			return Icons.Material.Filled.SportsEsports;
		else if (famiglia == "Xbox")
		 	return Icons.Material.Filled.VideogameAsset;
		else if (famiglia == "Nintendo")
			return Icons.Material.Filled.Gamepad;
		else if (famiglia == "Mobile")
		 	return Icons.Material.Filled.PhoneAndroid;
		else
			return Icons.Material.Filled.Games;
	}
	private List<string> Famiglie => Game.Platforms.Select( p => NomeFamiglia(p.Slug)).Distinct().ToList();
}

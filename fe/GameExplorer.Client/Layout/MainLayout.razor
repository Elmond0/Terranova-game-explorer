@inherits LayoutComponentBase
<MudThemeProvider @bind-IsDarkMode="_isDarkMode"/>
<MudPopoverProvider/>
<MudDialogProvider />
<MudSnackbarProvider/>

<MudLayout>
    <MudAppBar Elevation="1">
        <MudLink Href="/" Typo="Typo.h6" Color="Color.Inherit" Underline="Underline.None">
            Game Explorer
        </MudLink>
        <MudSpacer />
        <MudToggleIconButton
            @bind-Toggled="_isDarkMode"
            Icon="@Icons.Material.Filled.DarkMode"
            ToggledIcon="@Icons.Material.Filled.LightMode"
            Color="Color.Inherit"
            aria-label="Cambia tema"
        />
    </MudAppBar>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">
            @Body
        </MudContainer>
        <footer class="py-4">
            <MudText Typo="Typo.body2" Align="Align.Center" Class="mud-text-secondary">
                Dati forniti da
                <MudLink Href="https://rawg.io" Target="_blank" rel="noopener">
                    RAWG
                </MudLink>
            </MudText>
        </footer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _isDarkMode = true;
}

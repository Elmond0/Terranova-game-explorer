@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject CookieAuthenticationStateProvider Auth
@inject NavigationManager Navigation
@inject SearchFocusService SearchFocus

<MudThemeProvider @bind-IsDarkMode="_isDarkMode"/>
<MudPopoverProvider/>
<MudDialogProvider />
<MudSnackbarProvider/>

<MudLayout>
	<MudAppBar Elevation="1">
		<MudIconButton
			Icon="@Icons.Material.Filled.Menu"
			Color="Color.Inherit"
			Edge="Edge.Start"
			OnClick="ToggleDrawer"
			aria-label="Apri il menù"
		/>
		<MudLink Href="/" Typo="Typo.h6" Color="Color.Inherit" Underline="Underline.None">
			Game Explorer
		</MudLink>
		<MudSpacer />
		<MudToggleIconButton
			Toggled="_isDarkMode"
			ToggledChanged="OnThemeToggled"
			Icon="@Icons.Material.Filled.DarkMode"
			ToggledIcon="@Icons.Material.Filled.LightMode"
			Color="Color.Inherit"
			aria-label="Cambia tema"
		/>
	</MudAppBar>
	<MudDrawer
		@bind-Open="_drawerOpen"
		Variant="DrawerVariant.Responsive"
		ClipMode="DrawerClipMode.Always"
		Elevation="1"
	>
		<MudNavMenu>
			<MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>
			<MudNavLink OnClick="FocusSearchAsync" Icon="@Icons.Material.Filled.Search">Cerca</MudNavLink>
			<MudDivider Class="my-2" />
			<AuthorizeView>
				<Authorized>
					<MudText Class="px-4 py-2" Typo="Typo.subtitle2">@context.User.Identity?.Name</MudText>
					<MudNavLink Href="/profile" Icon="@Icons.Material.Filled.Person">Profilo</MudNavLink>
					<MudNavLink OnClick="LogoutAsync" Icon="@Icons.Material.Filled.Logout">Esci</MudNavLink>
				</Authorized>
				<NotAuthorized>
					<MudNavLink Href="/account/login" Icon="@Icons.Material.Filled.Login">Accedi</MudNavLink>
					<MudNavLink Href="/account/register" Icon="@Icons.Material.Filled.PersonAdd">Registrati</MudNavLink>
				</NotAuthorized>
			</AuthorizeView>
		</MudNavMenu>
	</MudDrawer>
	<MudMainContent>
		<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">
			<ErrorBoundary @ref="_errorBoundary">
				<ChildContent>
					@Body
				</ChildContent>
				<ErrorContent>
					<ErrorMessage
						Message="Si è verificato un errore imprevisto."
						OnRetry="() => _errorBoundary?.Recover()"
					/>
				</ErrorContent>
			</ErrorBoundary>
		</MudContainer>
		<footer class="py-4">
			<MudText Typo="Typo.body2" Align="Align.Center" Class="mud-text-secondary">
				Dati forniti da
				<MudLink Href="https://www.igdb.com" Target="_blank" rel="noopener">
					IGDB
				</MudLink>
			</MudText>
		</footer>
	</MudMainContent>
</MudLayout>

@code {
	private bool _isDarkMode = true;
	private bool _drawerOpen = true;

	private const string ThemeKey = "theme";
	private ErrorBoundary? _errorBoundary;
	protected override async Task OnInitializedAsync()
	{
		var savedTheme = await JS.InvokeAsync<string?>("localStorage.getItem", ThemeKey);
		if (savedTheme is not null)
		{
			_isDarkMode = savedTheme == "dark";
		}
	}
	protected override void OnParametersSet()
	{
		_errorBoundary?.Recover();
	}
	private async Task OnThemeToggled(bool isDark)
	{
		_isDarkMode = isDark;
		await JS.InvokeVoidAsync("localStorage.setItem", ThemeKey, isDark ? "dark" : "light");
	}
	private async Task LogoutAsync()
	{
		await Auth.LogoutAsync();
		Navigation.NavigateTo("/");
	}
	private void ToggleDrawer()
	{
		_drawerOpen = !_drawerOpen;
	}

	private async Task FocusSearchAsync()
	{
		await SearchFocus.RequestAsync();
		if (!SearchFocus.HasSearchBar)
			Navigation.NavigateTo("/");
	}
}

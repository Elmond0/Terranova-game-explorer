@page "/search"
@inject IGameApiClient Api
@inject NavigationManager Navigation
@inject SearchFocusService SearchFocus
@inject IJSRuntime JS
@implements IDisposable
@using System.Globalization
@using System.Net

<PageTitle>Ricerca · Game Explorer</PageTitle>

<MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-4">
	Cerca giochi
</MudText>

<MudStack
	Row="true"
	AlignItems="AlignItems.Center"
	Spacing="2"
	Class="mb-4">
		<MudTextField
			T="string"
			Value="_query"
			ValueChanged="OnQueryChanged"
			DebounceInterval="300"
			Clearable="true"
			Placeholder="Cerca un gioco..."
			Variant="Variant.Outlined"
			Adornment="Adornment.End"
			AdornmentIcon="@Icons.Material.Filled.Search"
			@ref="_searchField"
		/>
		@* Solo su schermi piccoli: lì i filtri stanno nel MudDrawer *@
		@* nowrap e flex-shrink 0: "Filtri (1)" resta su una riga, è il campo di ricerca a stringersi *@
		<MudButton
			Class="d-md-none flex-shrink-0"
			Style="white-space: nowrap"
			OnClick="() => _filtersOpen = true"
			Variant="Variant.Outlined"
			StartIcon="@Icons.Material.Filled.FilterList">
			Filtri@(ActiveFilterCount > 0 ? $" ({ActiveFilterCount})" : "")
		</MudButton>
</MudStack>

<MudDrawer
	@bind-Open="_filtersOpen"
	Anchor="Anchor.End"
	Variant="DrawerVariant.Temporary"
	Width="320px">
	<MudDrawerHeader Class="align-center">
		<MudText Typo="Typo.h6">Filtri</MudText>
		<MudSpacer/>
		<MudIconButton
			Icon="@Icons.Material.Filled.Close"
			OnClick="() => _filtersOpen = false"
			aria-label="Chiudi i filtri"
		/>
	</MudDrawerHeader>
	<div class="px-4 pb-4">
		@FiltersPanel
	</div>
</MudDrawer>

<MudGrid>
	@* Da md in su i filtri stanno in una colonna a sinistra *@
	<MudItem md="3" Class="d-none d-md-block">
		@FiltersPanel
	</MudItem>

	<MudItem xs="12" md="9">
		@* Anni sbagliati: la Web API non viene chiamata, quindi si spiega il motivo invece di "Nessun gioco trovato" *@
		@if (YearsInvalid)
		{
			<MudAlert Severity="Severity.Warning">
				Controlla gli anni: «Dal» deve venire prima di «Al», ed entrambi devono essere tra @MinYear e @MaxYear.
			</MudAlert>
		}
		else if (_badRequest)
		{
			<ErrorMessage Message="La ricerca contiene caratteri che non possiamo cercare: prova a toglierli."/>
		}
		else if (_error)
		{
			<ErrorMessage OnRetry="LoadAsync"/>
		}
		else if (_result is null)
		{
			<MudGrid Spacing="3">
				@for (var i = 0; i < 6; i++)
				{
					<MudItem xs="6" lg="4">
						<SkeletonCard/>
					</MudItem>
				}
			</MudGrid>
		}
		else if (_result.Items is null or { Count: 0 })
		{
			<NoResults/>
		}
		else
		{
			<MudText Typo="Typo.body2" Class="mud-text-secondary mb-2" role="status">
				@TotalText
			</MudText>
			<MudGrid Spacing="3">
				@* Anche sul telefono 2 card per riga: con 1 sola, 20 risultati occupavano circa 20 schermate *@
				@foreach (var game in _result.Items)
				{
					<MudItem xs="6" lg="4">
						<GameCard Game="game"/>
					</MudItem>
				}
			</MudGrid>
			@if (PageCount > 1)
			{
				<MudStack AlignItems="AlignItems.Center" Class="mt-6">
					<MudPagination
						Count="PageCount"
						Selected="CurrentPage"
						SelectedChanged="OnPageChanged"
						Color="Color.Primary"
					/>
				</MudStack>
			}
		}
	</MudItem>
</MudGrid>

@code {
	private const int PageSize = 20;
	private const int MinYear = 1950;
	private static readonly int MaxYear = DateTime.Today.Year + 5;
	private bool IsYearOutOfRange(int? year) => year is not null && (year < MinYear || year > MaxYear);
	private bool YearsInvalid => IsYearOutOfRange(FromYear) || IsYearOutOfRange(ToYear) || YearsInverted;
	private static IEnumerable<int?> YearsStartingWith(int firstYear, string? text)
	{
		return Enumerable.Range(firstYear, MaxYear - firstYear + 1)
			.Where(y => y.ToString().StartsWith(text ?? ""))
			.Reverse()
			.Select(y => (int?) y);
	}
	private Task<IEnumerable<int?>> SearchFromYears(string? text, CancellationToken token)
	{
		return Task.FromResult(YearsStartingWith(MinYear, text));
	}
	private static int? ParseInt(string? text)
	{
		return int.TryParse(text, out var n) ? n : null;
	}
	private static int[]? ParseInts(string[]? texts)
	{
		if (texts is null)
			return null;
		return texts.Select(ParseInt).Where(n => n is not null).Select(n => n!.Value).ToArray();
	}
	private Task<IEnumerable<int?>> SearchToYears(string? text, CancellationToken token)
	{
		 var firstYear = Math.Clamp(FromYear ?? MinYear, MinYear, MaxYear);
		return Task.FromResult(YearsStartingWith(firstYear, text));
	}
	private MudTextField<string>? _searchField;

	// Le voci del menu "Ordina per": valore accettato dalla Web API (SearchFilter.Ordering) senza "-" e testo da mostrare
	private static readonly (string Value, string Label)[] OrderFields =
	[
		("name", "Nome"),
		("released", "Data di uscita"),
		("rating", "Voto"),
	];

	[SupplyParameterFromQuery(Name = "q")] string? Query { get; set; }
	[SupplyParameterFromQuery(Name = "genres")] string[]? GenresText { get; set; }
	private int[]? Genres => ParseInts(GenresText);
	[SupplyParameterFromQuery(Name = "platforms")] string[]? PlatformsText { get; set; }
	private int[]? Platforms => ParseInts(PlatformsText);
	[SupplyParameterFromQuery(Name = "fromYear")] string? FromYearText { get; set; }
	private int? FromYear => ParseInt(FromYearText);
	[SupplyParameterFromQuery(Name = "toYear")] string? ToYearText { get; set; }
	private int? ToYear => ParseInt(ToYearText);
	[SupplyParameterFromQuery(Name = "ordering")] string? OrderingText { get; set; }
	private string? Ordering => OrderFields.Any(o => o.Value == OrderingText || "-" + o.Value == OrderingText) ? OrderingText : null;
	[SupplyParameterFromQuery(Name = "page")] string? PageText { get; set; }
	private int? Page => ParseInt(PageText);
	private PagedResult<Game>? _result;
	private bool _badRequest;
	private bool _error;
	private CancellationTokenSource? _cts;
	private string? _query;
	private List<Genre> _genres = [];
	private List<Platform> _platforms = [];
	private bool _loadingFilterLists;
	private int _platformPickerKey;
	private bool _filtersOpen;

	// ?page=0 o negativo scritto a mano nell'indirizzo vale come pagina 1
	private int CurrentPage => Math.Max(Page ?? 1, 1);
	// SearchFilter.Validate rifiuta "Dal" dopo "Al": la Web API risponderebbe 400
	private bool YearsInverted => FromYear > ToYear;
	private int PageCount => _result is null ? 0 : (int)Math.Ceiling(_result.Total / (double)PageSize);
	private string TotalText => _result?.Total == 1
		? "1 gioco trovato"
		: $"{_result?.Total.ToString("N0", CultureInfo.GetCultureInfo("it-IT"))} giochi trovati";

	// "-rating" → campo "rating", verso decrescente
	private string? OrderField => Ordering?.TrimStart('-');
	private bool OrderDescending => Ordering?.StartsWith('-') ?? false;

	private int ActiveFilterCount =>
		(Genres?.Length > 0 ? 1 : 0) + (Platforms?.Length > 0 ? 1 : 0)
		+ (FromYear is not null ? 1 : 0) + (ToYear is not null ? 1 : 0)
		+ (Ordering is not null ? 1 : 0);

	// Lo stesso pannello compare due volte: nella colonna (schermi grandi) e nel MudDrawer (smartphone)
	// @key: MudSelect calcola il testo ("Action, Adventure") una volta sola, quindi si ricrea quando arrivano gli elenchi
	private RenderFragment FiltersPanel => @<MudStack Spacing="3">
		<MudSelect
			@key="@($"genres-{_genres.Count}")"
			T="int"
			Label="Generi"
			MultiSelection="true"
			SelectedValues="Genres"
			SelectedValuesChanged="OnGenresChanged"
			ToStringFunc="GenreName"
			Clearable="true"
			Variant="Variant.Outlined">
			@foreach (var genre in _genres)
			{
				<MudSelectItem T="int" Value="genre.Id">@genre.Name</MudSelectItem>
			}
		</MudSelect>
		@* Le piattaforme sono più di 200: si cercano scrivendo, invece di scorrere un menu.
		   Quelle scelte compaiono sotto come chip, con la ✕ per toglierle.
		   @key cambia dopo ogni scelta, così il campo si ricrea vuoto e pronto per la prossima *@
		<MudAutocomplete
			@key="@($"platform-picker-{_platformPickerKey}")"
			T="Platform"
			Label="Piattaforme"
			Placeholder="Cerca una piattaforma..."
			SearchFunc="SearchPlatforms"
			ToStringFunc="@(p => p?.Name)"
			ValueChanged="AddPlatform"
			MaxItems="null"
			Variant="Variant.Outlined"
		/>
		@if (Platforms?.Length > 0)
		{
			<div class="d-flex flex-wrap gap-1">
				@foreach (var id in Platforms)
				{
					<MudChip
						T="int"
						Value="id"
						Size="Size.Small"
						Color="Color.Primary"
						OnClose="@(() => RemovePlatform(id))">
						@PlatformName(id)
					</MudChip>
				}
			</div>
		}
		<MudStack Row="true" Spacing="2">
			<MudAutocomplete
				T="int?"
				Label="Dal"
				Value="FromYear"
				ValueChanged="@((int? v) => NavigateWith("fromYear", v))"
				Error="@IsYearOutOfRange(FromYear)"
				ErrorText="@($"Tra {MinYear} e {MaxYear}")"
				Variant="Variant.Outlined"
				SearchFunc="SearchFromYears"
				MaxItems="null"
				Clearable="true"
				ResetValueOnEmptyText="true"
				Strict="false"
				Placeholder="2000"
			/>
			<MudAutocomplete
				T="int?"
				Label="Al"
				Value="ToYear"
				ValueChanged="@((int? v) => NavigateWith("toYear", v))"
				Error="@(IsYearOutOfRange(ToYear) || YearsInverted)"
				ErrorText="@(IsYearOutOfRange(ToYear) ? $"Tra {MinYear} e {MaxYear}" : "Prima di «Dal»")"
				Variant="Variant.Outlined"
				SearchFunc="SearchToYears"
				MaxItems="null"
				Clearable="true"
				ResetValueOnEmptyText="true"
				Strict="false"
				Placeholder="2026"
			/>
		</MudStack>
		<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
			<MudSelect
				T="string"
				Label="Ordina per"
				Value="OrderField"
				ValueChanged="OnOrderFieldChanged"
				ToStringFunc="OrderLabel"
				Clearable="true"
				Variant="Variant.Outlined">
				@foreach (var order in OrderFields)
				{
					<MudSelectItem T="string" Value="order.Value">@order.Label</MudSelectItem>
				}
			</MudSelect>
			<MudTooltip Text="@(OrderDescending ? "Decrescente" : "Crescente")">
				<MudIconButton
					Icon="@(OrderDescending ? Icons.Material.Filled.ArrowDownward : Icons.Material.Filled.ArrowUpward)"
					OnClick="ToggleOrderDirection"
					Disabled="OrderField is null"
					aria-label="@(OrderDescending ? "Ordine decrescente, passa a crescente" : "Ordine crescente, passa a decrescente")"
				/>
			</MudTooltip>
		</MudStack>
		@if (ActiveFilterCount > 0)
		{
			<MudButton
				OnClick="ResetFilters"
				Variant="Variant.Text"
				StartIcon="@Icons.Material.Filled.FilterListOff">
				Azzera filtri
			</MudButton>
		}
	</MudStack>;
	protected override Task OnParametersSetAsync()
	{
		_query = Query;
		return LoadAsync();
	}

	private async Task LoadFilterListsAsync()
	{
		if (_loadingFilterLists || (_genres.Count > 0 && _platforms.Count > 0))
			return;
		_loadingFilterLists = true;
		try
		{
			var genres = Api.GetGenresAsync();
			var platforms = Api.GetPlatformsAsync();
			_genres = await genres;
			_platforms = await platforms;
			StateHasChanged();
		}
		catch (ApiException)
		{
			// Senza elenchi i menu restano vuoti: si riprova alla prossima ricerca
		}
		finally
		{
			_loadingFilterLists = false;
		}
	}

	private async Task LoadAsync()
	{
		// Gli elenchi dei filtri si ritentano a ogni ricerca finché non arrivano, senza far aspettare la ricerca
		_ = LoadFilterListsAsync();
		_cts?.Cancel();
		_cts?.Dispose();
		_cts = new CancellationTokenSource();
		var token = _cts.Token;
		_error = false;
		_badRequest = false;
		_result = null;
		if (YearsInvalid)
		{
			_result = new PagedResult<Game>();
			return;
		}
		var filter = new SearchFilter
		{
			Query = Query ?? "",
			GenreIds = Genres?.ToList() ?? [],
			PlatformIds = Platforms?.ToList() ?? [],
			FromYear = FromYear,
			ToYear = ToYear,
			Ordering = Ordering,
			Page = CurrentPage,
			PageSize = PageSize,
		};
		try
		{
			_result = await Api.SearchAsync(filter, token);
		}
		catch (ApiException ex) when(ex.StatusCode == HttpStatusCode.BadRequest)
		{
			_badRequest = true;
		}
		catch (ApiException)
		{
			_error = true;
		}
		catch (OperationCanceledException) { }
	}

	private async Task FocusSearchFieldAsync()
	{
		if (_searchField is not null)
			await _searchField.FocusAsync();
	}

	protected override void OnInitialized()
	{
		SearchFocus.Requested += FocusSearchFieldAsync;
	}

	public void Dispose()
	{
		_cts?.Cancel();
		_cts?.Dispose();
		SearchFocus.Requested -= FocusSearchFieldAsync;
	}

	private string GenreName(int id) => _genres.FirstOrDefault(g => g.Id == id)?.Name ?? id.ToString();

	private string PlatformName(int id) => _platforms.FirstOrDefault(p => p.Id == id)?.Name ?? id.ToString();

	private static string? OrderLabel(string? value) => OrderFields.FirstOrDefault(o => o.Value == value).Label ?? value;

	private void OnQueryChanged(string? value)
	{
		_query = value;
		NavigateWith("q", string.IsNullOrWhiteSpace(value) ? null : value, replace: true);
	}

	private void OnGenresChanged(IEnumerable<int> values) =>
		NavigateWith("genres", values.Any() ? values.ToArray() : null);

	// Elenco del campo Piattaforme: quelle che contengono il testo scritto, senza quelle già scelte
	private Task<IEnumerable<Platform>> SearchPlatforms(string? text, CancellationToken token)
	{
		var selected = Platforms ?? [];
		var matches = _platforms.Where(p => !selected.Contains(p.Id)
			&& (string.IsNullOrWhiteSpace(text) || p.Name.Contains(text.Trim(), StringComparison.OrdinalIgnoreCase)));
		return Task.FromResult(matches);
	}

	private void AddPlatform(Platform? platform)
	{
		if (platform is null)
			return;
		_platformPickerKey++;
		NavigateWith("platforms", (Platforms ?? []).Append(platform.Id).ToArray());
	}

	private void RemovePlatform(int id)
	{
		var rest = (Platforms ?? []).Where(p => p != id).ToArray();
		NavigateWith("platforms", rest.Length > 0 ? rest : null);
	}

	// Un campo nuovo tiene il verso scelto prima; senza un ordinamento precedente,
	// il nome va dalla A alla Z e gli altri dal valore più alto
	private void OnOrderFieldChanged(string? field)
	{
		if (field is null)
		{
			NavigateWith("ordering", null);
			return;
		}
		var descending = Ordering is null ? field != "name" : OrderDescending;
		NavigateWith("ordering", descending ? $"-{field}" : field);
	}

	private void ToggleOrderDirection()
	{
		if (OrderField is null)
			return;
		NavigateWith("ordering", OrderDescending ? OrderField : $"-{OrderField}");
	}

	// Il testo resta: "Azzera filtri" toglie solo i filtri e l'ordinamento
	private void ResetFilters()
	{
		Navigate(new Dictionary<string, object?>
		{
			["genres"] = null,
			["platforms"] = null,
			["fromYear"] = null,
			["toYear"] = null,
			["ordering"] = null,
			["page"] = null,
		});
	}

	// La pagina 1 non si scrive nell'indirizzo: /search?q=zelda e /search?q=zelda&page=1 sono la stessa ricerca
	private async Task OnPageChanged(int page)
	{
		Navigate(new Dictionary<string, object?> { ["page"] = page == 1 ? null : page });
		await JS.InvokeVoidAsync("scrollTo", 0, 0);
	}

	// Un filtro nuovo riporta sempre a pagina 1
	private void NavigateWith(string key, object? value, bool replace = false)
	{
		Navigate(new Dictionary<string, object?>
		{
			[key] = value,
			["page"] = null,
		}, replace);
	}

	// Cambia solo l'indirizzo: la ricerca la fa partire OnParametersSetAsync
	private void Navigate(Dictionary<string, object?> changes, bool replace = false)
	{
		Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(changes), replace: replace);
	}
}

@page "/"
@inject IGameApiClient Api

<PageTitle>Home · Game Explorer</PageTitle>
<MudText
	Typo="Typo.h3"
	HtmlTag="h1"
	Align="Align.Center">
		Game Explorer
</MudText>
<MudText
	Typo="Typo.body1"
	Align="Align.Center"
	Class="mud-text-secondary mb-4">
		Cerca tra migliaia di videogiochi, filtra per genere, piattaforma e anno, leggi schede, voti e studi di sviluppo, e salva i tuoi preferiti.
</MudText>
<HomeSearchBar/>

<GameSection
	Title="Più apprezzati"
	Load="Api.GetTopRatedAsync"
	SeeAllHref="games/top-rated"
/>
<GameSection
	Title="Usciti di recente"
	Load="Api.GetRecentAsync"
	HighlightDate="true"
	SeeAllHref="games/recent"
/>

<GameSection
	Title="In arrivo"
	Load="Api.GetUpcomingAsync"
	HighlightDate="true"
	SeeAllHref="games/upcoming"
/>

<MudText
	Typo="Typo.h4"
	HtmlTag="h2"
	Align="Align.Center"
	Class="mt-8 mb-4">
		Per Piattaforme
</MudText>

@foreach (var platform in PlatformSections)
{
	<GameSection
		Title="@(platform.Title)"
		Load="ct => Api.GetPlatformHighlightsAsync(platform.PlatformId, ct)"
		SeeAllHref="@($"search?platforms={platform.PlatformId}")"
	/>
}

@code {
	private static readonly (string Title, int PlatformId)[] PlatformSections =
	[
		("PlayStation", 167),
		("Xbox", 169),
		("Nintendo", 130),
		("Pc", 6)
	];
}

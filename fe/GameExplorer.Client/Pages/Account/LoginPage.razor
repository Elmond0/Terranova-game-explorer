@page "/account/login"
@inject CookieAuthenticationStateProvider Auth
@inject NavigationManager Navigation


<PageTitle>Accedi · Game Explorer</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small">
	<MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-4">Accedi</MudText>

	@if (_alreadyLoggedIn)
	{
		@* a message instead of an automatic redirect: a redirect while the page opens stays
		   in the history, and Back would always lead here again *@
		<MudAlert Severity="Severity.Info" Class="mb-4">Hai già fatto l'accesso.</MudAlert>
		<MudButton Href="@SafeReturnUrl" Variant="Variant.Filled" Color="Color.Primary">Continua</MudButton>
	}
	else
	{
		<MudPaper Class="pa-6">
			<form @onsubmit="SubmitAsync">
				@* name and autocomplete: without them the browser password manager does not recognize and fill the fields *@
				<MudTextField @bind-Value="_email" Label="Email" InputType="InputType.Email" Class="mb-3" name="email" autocomplete="username"/>
				<MudTextField @bind-Value="_password" Label="Password" InputType="InputType.Password" Class="mb-3" name="password" autocomplete="current-password"/>

				@if (_error is not null)
				{
					<MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
				}

				<MudButton ButtonType="ButtonType.Submit" Disabled="_busy" Variant="Variant.Filled" Color="Color.Primary">Accedi</MudButton>
			</form>
		</MudPaper>

		<MudText Class="mt-4">
			Non hai un account? <MudLink Href="/account/register">Registrati</MudLink>
		</MudText>
	}
</MudContainer>

@code{
	[CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
	private string _email = "";
	private string _password = "";
	private string? _error;
	private bool _busy;
	[SupplyParameterFromQuery] string? ReturnUrl { get; set; }
	private string SafeReturnUrl => ReturnUrl is not null && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//" ) && !ReturnUrl.StartsWith("/\\")
			? ReturnUrl
			: "/";

	private bool _alreadyLoggedIn;

	// a logged-in user gets no form but a button to where the login would have taken them, so a stale link is not a dead end
	protected override async Task OnInitializedAsync()
	{
		var state = AuthState is null ? null : await AuthState;
		_alreadyLoggedIn = state?.User.Identity?.IsAuthenticated == true;
	}

	private async Task SubmitAsync()
	{
		_error = null;
		// empty fields: calling the web api would only use up one of the 10 attempts per minute
		if (string.IsNullOrWhiteSpace(_email) || string.IsNullOrEmpty(_password))
		{
			_error = "Inserisci email e password";
			return;
		}
		_busy = true;
		try
		{
			var res = await Auth.LoginAsync(_email, _password);
			if (res)
				Navigation.NavigateTo(SafeReturnUrl, replace: true);
			else
				_error = "Email o password sbagliate";
		}
		catch (HttpRequestException)
		{
			_error = "Accesso non riuscito, riprova più tardi";
		}
		finally
		{
			_busy = false;
		}
	}
}

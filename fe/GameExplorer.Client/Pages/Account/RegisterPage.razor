@page "/account/register"
@inject CookieAuthenticationStateProvider Auth
@inject NavigationManager Navigation


<PageTitle>Registrati</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small">
	<MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-4">Registrati</MudText>

	<MudPaper Class="pa-6">
		<form @onsubmit="SubmitAsync">
			<MudTextField
				@bind-Value="_email"
				Label="Email"
				InputType="InputType.Email"
				Class="mb-3"
			/>
			<MudTextField
				@bind-Value="_password"
				Label="Password"
				InputType="InputType.Password"
				HelperText="Da 8 a 128 caratteri, con almeno una lettera maiuscola e un carattere speciale"
				Class="mb-3"
				Validation="@(new Func<string, string?>(ValidatePassword))"
				DebounceInterval="600"
			/>
			<MudTextField
				@bind-Value="_passwordConfirmation"
				Label="Conferma password"
				InputType="InputType.Password"
				Class="mb-3"
				Validation="@(new Func<string, string?>(c => c != _password ? PasswordDiffMessage : null))"
				DebounceInterval="600"
			/>

			@if (_error is not null)
			{
				<MudAlert
					Severity="Severity.Error"
					Class="mb-3">
					@_error
				</MudAlert>
			}

			<MudButton
				ButtonType="ButtonType.Submit"
				Disabled="_busy"
				Variant="Variant.Filled"
				Color="Color.Primary">
				Registrati
			</MudButton>
		</form>
	</MudPaper>

	<MudText Class="mt-4">
		Hai già un account? <MudLink Href="/account/login">Accedi</MudLink>
	</MudText>
</MudContainer>

@code{
	private const string PasswordDiffMessage = "Le password non coincidono";
	private const string PasswordLengthMessage = "La password deve avere da 8 a 128 caratteri";
	private const string PasswordUpperMessage = "La password deve contenere almeno una lettera maiuscola";
	private const string PasswordSpecialMessage = "La password deve contenere almeno un carattere speciale";

	private string _email = "";
	private string _password = "";
	private string _passwordConfirmation = "";
	private string? _error;
	private bool _busy;

	private async Task SubmitAsync()
	{
		if (ValidatePassword(_password) is { } passwordError)
		{
			_error = passwordError;
			return;
		}
		if (_password != _passwordConfirmation)
		{
			_error = PasswordDiffMessage;
			return;
		}
		_busy = true;
		_error = null;
		try
		{
			var errors = await Auth.RegisterAsync(_email, _password);
			if (errors.Length == 0)
				Navigation.NavigateTo("/");
			else
				_error = ToMessage(errors);
		}
		catch (HttpRequestException)
		{
			_error = "Registrazione non riuscita, riprova più tardi";
		}
		finally
		{
			_busy = false;
		}
	}
	private static string ToMessage(string[] errors)
	{
		if (errors.Contains("DuplicateUserName"))
		{
			return "Questa email è già registrata";
		}
		if (errors.Contains("InvalidEmail"))
		{
			return "Email non valida";
		}
		if (errors.Contains("PasswordLength"))
		{
			return PasswordLengthMessage;
		}
		if (errors.Contains("PasswordRequiresUpper"))
		{
			return PasswordUpperMessage;
		}
		if (errors.Contains("PasswordRequiresNonAlphanumeric"))
		{
			return PasswordSpecialMessage;
		}
		return "Registrazione non riuscita";
	}
	private static string? ValidatePassword(string password)
	{
		if (password.Length < 8 || password.Length > 128)
		{
			return PasswordLengthMessage;
		}
		if (!password.Any(char.IsUpper))
		{
			return PasswordUpperMessage;
		}
		if (!password.Any(c => !char.IsLetterOrDigit(c)))
		{
			return PasswordSpecialMessage;
		}
		return null;
	}
}

@using System.Globalization

@page "/games/{Id:int}"
@inject IGameApiClient Api
@implements IDisposable

<PageTitle>@(_game?.Name ?? "Gioco") · Game Explorer</PageTitle>
@if (_error)
{
	<ErrorMessage OnRetry="LoadAsync"/>
}
else if (_loading)
{
	<Loading Text="Caricamento..."/>
}
else if (_game is null)
{
	<NotFoundMessage
		Title="Gioco non trovato"
		Text="Il gioco che cerchi non esiste o è stato rimosso."
	/>
}
else
{
	<MudGrid>
		<MudItem xs="12" md="4">
			@if (_game.Image?.Url is not null)
			{
				<div class="cover-box">
					<MudImage
						Fluid="true"
						Class="rounded-lg"
						Src="@_game.Image.Url"
						Alt="@_game.Name"
						Style="@CoverMaxWidth(_game.Image)"
					/>
				</div>
			}
			else
			{
				<div class="cover cover-placeholder">
					<MudIcon Icon="@Icons.Material.Filled.ImageNotSupported" Size="Size.Large" />
				</div>
			}
		</MudItem>
		<MudItem xs="12" md="8">
			<MudText Typo="Typo.h3" HtmlTag="h1">
				@_game.Name
			</MudText>
			<MudText Typo="Typo.body1" Class="mud-text-secondary">
				@ReleaseDateText
			</MudText>
			@if (_game.Rating > 0)
			{
				<MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
					<MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" Color="Color.Warning" />
					<MudText Typo="Typo.body2">
						@_game.Rating.ToString("0.0 '/ 100'", CultureInfo.GetCultureInfo("it-IT"))
					</MudText>
				</MudStack>
			}
			else
			{
				<MudText Typo="Typo.body2" Class="mud-text-secondary">
					Nessun voto
				</MudText>
			}
			<SaveButtons GameId="_game.Id" />
			@if (_game.Genres.Count > 0)
			{
				<MudText Typo="Typo.subtitle2" Class="mt-4">
					Generi
				</MudText>
				<MudStack Row="true" Wrap="Wrap.Wrap">
					@foreach (var genre in _game.Genres)
					{
						<MudChip T="string" Href="@($"/search?genres={genre.Id}")" Color="Color.Primary">
							@genre.Name
						</MudChip>
					}
				</MudStack>
			}
			@if (_game.Platforms.Count > 0)
			{
				<MudText Typo="Typo.subtitle2" Class="mt-4">
					Piattaforme
				</MudText>
				<MudStack Row="true" Wrap="Wrap.Wrap">
					@foreach (var piattaforme in _game.Platforms)
					{
						<MudChip T="string" Href="@($"/search?platforms={piattaforme.Id}")" Color="Color.Primary">
							@piattaforme.Name
						</MudChip>
					}
				</MudStack>
			}
			@if (NamedDevelopers.Count > 0)
			{
				<MudText Typo="Typo.subtitle2" Class="mt-4">
					Sviluppatori
				</MudText>
				<MudStack Row="true" Wrap="Wrap.Wrap">
					@foreach (var studio in NamedDevelopers)
					{
						<MudChip T="string" Href="@($"/studios/{studio.Id}")" Color="Color.Primary">
							@studio.Name
						</MudChip>
					}
				</MudStack>
			}
			@if (NamedPublishers.Count > 0)
			{
				<MudText Typo="Typo.subtitle2" Class="mt-4">
					Publisher
				</MudText>
				<MudStack Row="true" Wrap="Wrap.Wrap">
					@foreach (var publisher in NamedPublishers)
					{
						<MudChip T="string" Color="Color.Primary" Href="@($"/studios/{publisher.Id}")">
							@publisher.Name
						</MudChip>
					}
				</MudStack>
			}
		</MudItem>
	</MudGrid>
	@if (!string.IsNullOrWhiteSpace(_game.Description))
	{
		<MudText
			Typo="Typo.h5"
			HtmlTag="h2"
			Class="mt-6 mb-2">
			Descrizione
		</MudText>
		<p class="about">@AboutText</p>
		@if (IsAboutLong)
		{
			<MudButton Variant="Variant.Text" OnClick="() => _aboutExpanded = !_aboutExpanded">
				@(_aboutExpanded ? "Mostra meno" : "Leggi tutto")
			</MudButton>
		}
	}
	@if (ScreenshotUrls.Count > 0)
	{
		<MudText Typo="Typo.h5" HtmlTag="h2" Class="mt-6 mb-2">
			Screenshot
		</MudText>
		<MudGrid Spacing="2">
			@for (var i = 0; i < ScreenshotUrls.Count; i++)
			{
				var index = i;
				<MudItem xs="6" sm="4" md="3">
					<button
						type="button"
						class="thumb"
						aria-label="Apri screenshot @(index + 1)"
						@onclick="() => OpenViewer(index)">
						<img
							src="@ScreenshotUrls[index]"
							alt="Screenshot @(index + 1) di @_game.Name"
							loading="lazy"
						/>
					</button>
				</MudItem>
			}
		</MudGrid>
		<MudDialog @bind-Visible="_viewerOpen" Options="_viewerOptions" DefaultFocus="DefaultFocus.LastChild">
			<TitleContent>
				@if (_viewerOpen)
				{
					<MudStack Row="true" AlignItems="AlignItems.Center">
						<MudText Typo="Typo.h6">
							Screenshot @(_viewerIndex + 1) di @ScreenshotUrls.Count
						</MudText>
						<MudSpacer/>
						<MudIconButton
							Icon="@Icons.Material.Filled.Close"
							aria-label="Chiudi"
							OnClick="() => _viewerOpen = false"
							@onkeydown="OnViewerKeyDown"
						/>
					</MudStack>
				}
			</TitleContent>
			<DialogContent>
				@if (_viewerOpen)
				{
					<div class="viewer" @onkeydown="OnViewerKeyDown">
						<MudIconButton
							Icon="@Icons.Material.Filled.ChevronLeft"
							aria-label="Precedente"
							OnClick="Previous"
							Class="viewer-prev"
						>
						</MudIconButton>
						<img
							src="@ScreenshotUrls[_viewerIndex]"
							alt="Screenshot @(_viewerIndex + 1) di @_game.Name"
						/>
						<MudIconButton
							Icon="@Icons.Material.Filled.ChevronRight"
							aria-label="Successivo"
							OnClick="Next"
							Class="viewer-next"
						>
						</MudIconButton>
					</div>
				}
			</DialogContent>
		</MudDialog>
	}
}

@code {
	[Parameter] public int Id { get; set; }
	private const int AboutPreviewLength = 500;
	// "Leggi tutto" only when the hidden text is long enough: hiding just a few words would cost a click for nothing
	private const int AboutTolerance = 150;
	// IGDB already sends its largest file (t_original): more than twice its real size would look blurred
	private static string? CoverMaxWidth(Image image) => image.Width > 0
		? $"width: 100%; max-width: min(100%, {image.Width * 2}px)"
		: null;
	private CancellationTokenSource? _cts;
	private bool _aboutExpanded;
	private GameDetails? _game;
	private List<Studio> NamedDevelopers => _game?.Developers.Where(s => !string.IsNullOrWhiteSpace(s.Name)).ToList() ?? [];
	private List<Studio> NamedPublishers => _game?.Publishers.Where(s => !string.IsNullOrWhiteSpace(s.Name)).ToList() ?? [];
	private bool _viewerOpen;
	private int _viewerIndex;
	private bool _loading;
	private bool _error;
	private readonly DialogOptions _viewerOptions = new()
	{
		CloseOnEscapeKey = true,
		CloseButton = false,
		MaxWidth = MaxWidth.Large,
		FullWidth = true,
	};
	private bool IsAboutLong => _game?.Description?.Length > AboutPreviewLength + AboutTolerance;
	private List<string> ScreenshotUrls => _game?.Screenshots.Select(s => s?.Url).OfType<string>().ToList() ?? [];
	private void OpenViewer(int index)
	{
		_viewerIndex = index;
		_viewerOpen = true;
	}
	private void Next()
	{
		_viewerIndex = (_viewerIndex + 1) % ScreenshotUrls.Count;
	}
	private void Previous()
	{
		_viewerIndex = (_viewerIndex - 1 + ScreenshotUrls.Count) % ScreenshotUrls.Count;
	}
	private void OnViewerKeyDown(KeyboardEventArgs e)
	{
		if (e.Key == "ArrowRight")
			Next();
		if (e.Key == "ArrowLeft")
			Previous();
	}
	// cut at the last space before the limit, so a word is never split in half
	private string AboutText
	{
		get
		{
			var about = _game?.Description ?? "";
			if (!IsAboutLong || _aboutExpanded)
				return about;

			var cut = about.LastIndexOf(' ', AboutPreviewLength);
			if (cut < 0)
				cut = AboutPreviewLength;
			return about[..cut] + "…";
		}
	}
	private string ReleaseDateText => _game?.ReleaseDate is null
		? "Data da annunciare"
		: _game.ReleaseDate.Value.ToString("d MMM yyyy", CultureInfo.GetCultureInfo("it-IT"));

	protected override async Task OnParametersSetAsync()
	{
		await LoadAsync();
	}
	private async Task LoadAsync()
	{
		_cts?.Cancel();
		_cts?.Dispose();
		_cts = new CancellationTokenSource();
		var token = _cts.Token;
		_loading = true;
		_error = false;
		_game = null;
		try
		{
			var game = await Api.GetGameAsync(Id, token);
			if (token.IsCancellationRequested)
				return;
			_game = game;
			_viewerIndex = 0;
			_loading = false;
			_viewerOpen = false;
			_aboutExpanded = false;
		}
		catch (ApiException)
		{
			_error = true;
			_loading = false;
		}
		catch (OperationCanceledException) when (token.IsCancellationRequested)
		{ }
	}
	public void Dispose()
	{
		_cts?.Cancel();
		_cts?.Dispose();
	}
}

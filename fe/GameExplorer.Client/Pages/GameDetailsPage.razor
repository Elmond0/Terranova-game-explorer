@using System.Globalization

@page "/games/{Id:int}"
@inject IGameApiClient Api
@implements IDisposable

<PageTitle>@(_game?.Name ?? "Gioco")</PageTitle>
@if (_error)
{
	<ErrorMessage OnRetry="LoadAsync"/>
}
else if (_loading)
{
	<Loading Text="Caricamento..."/>
}
else if (_game is null)
{
	<MudText Typo="Typo.h5" HtmlTag="h1">Gioco non trovato</MudText>
	<MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary">
		Torna alla home
	</MudButton>
}
else
{
	<MudGrid>
		<MudItem xs="12" md="4">
			@if (_game.Image is not null)
			{
				<MudImage
					Fluid="true"
					Class="rounded-lg"
					Src="@_game.Image"
					Alt="@_game.Name"
				/>
			}
			else
			{
				<div class="cover cover-placeholder">
					<MudIcon Icon="@Icons.Material.Filled.ImageNotSupported" Size="Size.Large" />
				</div>
			}
		</MudItem>
		<MudItem xs="12" md="8">
			<MudText Typo="Typo.h3" HtmlTag="h1">
				@_game.Name
			</MudText>
			<MudText Typo="Typo.body1" Class="mud-text-secondary">
				@ReleaseDateText
			</MudText>
			@if (_game.Rating > 0)
			{
				<MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
					<MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" Color="Color.Warning" />
					<MudText Typo="Typo.body2">
						@_game.Rating.ToString("0.0 / 5", CultureInfo.GetCultureInfo("it-IT"))
					</MudText>
				</MudStack>
			}
			else
			{
				<MudText Typo="Typo.body2" Class="mud-text-secondary">
					Nessun voto
				</MudText>
			}
			@if (_game.Metacritic is int score)
			{
				<MudChip T="string" Variant="Variant.Filled" Color="MetacriticColor(score)">
					Metacritic @score
				</MudChip>
			}
			@if (_game.Genres.Count > 0)
			{
				<MudText Typo="Typo.subtitle2" Class="mt-4">
					Generi
				</MudText>
				<MudStack Row="true" Wrap="Wrap.Wrap">
					@foreach (var genre in _game.Genres)
					{
						<MudChip T="string" Href="@($"/search?genres={genre.Id}")" Color="Color.Primary">
							@genre.Name
						</MudChip>
					}
				</MudStack>
			}
			@if (_game.Platforms.Count > 0)
			{
				<MudText Typo="Typo.subtitle2" Class="mt-4">
					Piattaforme
				</MudText>
				<MudStack Row="true" Wrap="Wrap.Wrap">
					@foreach (var piattaforme in _game.Platforms)
					{
						<MudChip T="string" Href="@($"/search?platforms={piattaforme.Id}")" Color="Color.Primary">
							@piattaforme.Name
						</MudChip>
					}
				</MudStack>
			}
			@if (_game.Developers.Count > 0)
			{
				<MudText Typo="Typo.subtitle2" Class="mt-4">
					Sviluppatori
				</MudText>
				<MudStack Row="true" Wrap="Wrap.Wrap">
					@foreach (var studio in _game.Developers)
					{
						<MudChip T="string" Href="@($"/studios/{studio.Id}")" Color="Color.Primary">
							@studio.Name
						</MudChip>
					}
				</MudStack>
			}
			@if (_game.Publishers.Count > 0)
			{
				<MudText Typo="Typo.subtitle2" Class="mt-4">
					Publisher
				</MudText>
				<MudStack Row="true" Wrap="Wrap.Wrap">
					@foreach (var publisher in _game.Publishers)
					{
						<MudChip T="string" Color="Color.Primary">
							@publisher.Name
						</MudChip>
					}
				</MudStack>
			}
		</MudItem>
	</MudGrid>
	@if (!string.IsNullOrWhiteSpace(_game.About))
	{
		<MudText
			Typo="Typo.h5"
			HtmlTag="h2"
			Class="mt-6 mb-2">
			Descrizione
		</MudText>
		<MudText Style="white-space: pre-line">
			@AboutText
		</MudText>
		@if (IsAboutLong)
		{
			<MudButton Variant="Variant.Text" OnClick="() => _aboutExpanded = !_aboutExpanded">
				@(_aboutExpanded ? "Mostra meno" : "Leggi tutto")
			</MudButton>
		}
	}
}

@code {
	[Parameter] public int Id { get; set; }
	private const int AboutPreviewLength = 500;
	private CancellationTokenSource? _cts;
	private bool _aboutExpanded;
	private GameDetails? _game;
	private bool _loading;
	private bool _error;
	private bool IsAboutLong => _game?.About?.Length > AboutPreviewLength;
	// Testo da mostrare nella descrizione: intero, oppure tagliato all'ultimo spazio prima del limite
	private string AboutText
	{
		get
		{
			var about = _game?.About ?? "";
			if (!IsAboutLong || _aboutExpanded)
				return about;

			var cut = about.LastIndexOf(' ', AboutPreviewLength);
			if (cut < 0)
				cut = AboutPreviewLength;
			return about[..cut] + "…";
		}
	}
	private string ReleaseDateText => _game?.ReleaseDate is null
		? "Data da annunciare"
		: _game.ReleaseDate.Value.ToString("d MMM yyyy", CultureInfo.GetCultureInfo("it-IT"));

	protected override async Task OnParametersSetAsync()
	{
		await LoadAsync();
	}
	private async Task LoadAsync()
	{
		_cts?.Cancel();
		_cts?.Dispose();
		_cts = new CancellationTokenSource();
		var token = _cts.Token;
		_loading = true;
		_error = false;
		_game = null;
		try
		{
			var game = await Api.GetGameAsync(Id, token);
			if (token.IsCancellationRequested)
				return;
			_game = game;
			_aboutExpanded = false;
			_loading = false;
		}
		catch (ApiException)
		{
			_error = true;
			_loading = false;
		}
		catch (OperationCanceledException) when (token.IsCancellationRequested)
		{ }
	}
	private static Color MetacriticColor(int score)
	{
		if (score >= 75)
			return Color.Success;
		else if (score >= 50 && score <= 74)
			return Color.Warning;
		return Color.Error;
	}
	public void Dispose()
	{
		_cts?.Cancel();
		_cts?.Dispose();
	}
}

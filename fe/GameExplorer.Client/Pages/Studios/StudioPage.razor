@page "/studios/{Id:int}"
@inject IGameApiClient Api
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable
@using System.Globalization

<PageTitle>@(_studio?.Name ?? "Studio") · Game Explorer</PageTitle>

@if (_error)
{
	<ErrorMessage OnRetry="LoadStudioAsync"/>
}
else if (_loading)
{
	<Loading Text="Caricamento..."/>
}
else if (_studio is null)
{
	<NotFoundMessage
		Title="Studio non trovato"
		Text="Lo studio che cerchi non esiste o è stato rimosso."
	/>
}
else
{
	<MudGrid>
		<MudItem xs="12" md="4">
			<div class="logo-box rounded-lg">
				@if (_studio.Image?.Url is not null)
				{
					<MudImage
						Src="@_studio.Image.Url"
						Alt="@_studio.Name"
						ObjectFit="ObjectFit.Contain"
						Style="@MaxUpscale(_studio.Image)"
					/>
				}
				else
				{
					<MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Large" />
				}
			</div>
		</MudItem>
		<MudItem xs="12" md="8">
			<MudText Typo="Typo.h3" HtmlTag="h1">
				@_studio.Name
			</MudText>
			<MudText Typo="Typo.body1" Class="mud-text-secondary">
				@if (_games is not null)
				{
					@GamesWord(_games.Total)
				}
			</MudText>
			@if (StudioFacts is not null)
			{
				<MudText Typo="Typo.body1" Class="mud-text-secondary">
					@StudioFacts
				</MudText>
			}
			@if (!string.IsNullOrWhiteSpace(_studio.Website))
			{
				<MudLink
					Href="@_studio.Website"
					Target="_blank"
					rel="noopener noreferrer"
					Class="d-inline-flex align-center gap-1 mt-2">
					<MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" />
					Sito ufficiale
				</MudLink>
			}
			@if (!string.IsNullOrWhiteSpace(_studio.About))
			{
				<p class="about">@AboutText</p>
				@if (IsAboutLong)
				{
					<MudButton Variant="Variant.Text" OnClick="() => _aboutExpanded = !_aboutExpanded">
						@(_aboutExpanded ? "Mostra meno" : "Leggi tutto")
					</MudButton>
				}
			}
		</MudItem>
	</MudGrid>

	<div class="mt-8">
		<GameSection
			Title="In arrivo"
			Load="ct => Api.GetStudioUpcomingAsync(Id, ct)"
			HighlightDate="true"
			HideWhenEmpty="true"
		/>
	</div>
	<MudText Typo="Typo.h5" HtmlTag="h2" Class="mt-8 mb-4">
		Giochi
	</MudText>

	@if (_gamesError)
	{
		<ErrorMessage OnRetry="LoadGamesAsync"/>
	}
	else if (_games is null)
	{
		<MudGrid Spacing="3">
			@for (var i = 0; i < 4; i++)
			{
				<MudItem xs="12" sm="6" md="4" lg="3">
					<SkeletonCard/>
				</MudItem>
			}
		</MudGrid>
	}
	else if (_games.Items is null or { Count: 0 })
	{
		<NoResults Message="Nessun gioco di questo studio."/>
	}
	else
	{
		<div class="mb-4" role="status">
			@if (RatedGames.Count > 0)
			{
				<MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
					<MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" Color="Color.Warning" />
					<MudText Typo="Typo.body1">
						Voto medio <strong>@AverageRating.ToString("0.0 '/ 100'", ItalianCulture)</strong>
					</MudText>
				</MudStack>
				<MudText Typo="Typo.body2" Class="mud-text-secondary">
					Calcolato su @GamesWord(RatedGames.Count) con un voto (@GamesWord(_games.Items.Count) in questa pagina)
				</MudText>
			}
			else
			{
				<MudText Typo="Typo.body2" Class="mud-text-secondary">
					Nessun voto sui giochi di questa pagina
				</MudText>
			}
		</div>
		<MudGrid Spacing="3">
			@foreach (var game in _games.Items)
			{
				<MudItem xs="12" sm="6" md="4" lg="3">
					<GameCard Game="game"/>
				</MudItem>
			}
		</MudGrid>
		@if (PageCount > 1)
		{
			<MudStack AlignItems="AlignItems.Center" Class="mt-6">
				<MudPagination
					Count="PageCount"
					Selected="CurrentPage"
					SelectedChanged="OnPageChanged"
					Color="Color.Primary"
				/>
			</MudStack>
		}
	}
}

@code {
	[Parameter] public int Id { get; set; }
	[SupplyParameterFromQuery] int? Page { get; set; }

	// fallback when the web api leaves PageSize empty, so the page count is never a division by zero
	private const int DefaultPageSize = 20;
	private const int AboutPreviewLength = 500;
	private static readonly CultureInfo ItalianCulture = CultureInfo.GetCultureInfo("it-IT");
	// IGDB already sends its largest file (t_original): more than twice its real size would look blurred
	private static string? MaxUpscale(Image image) => image.Width > 0 && image.Height > 0
		? $"max-width: {image.Width * 2}px; max-height: {image.Height * 2}px"
		: null;
	private string? CountryName =>
		_studio?.CountryId is int id && CountryNames.ByIsoNumeric.TryGetValue(id, out var name) ? name : null;

	// IGDB company status: 0 active, 1 defunct, 2 merged, 3 renamed (read from real studios, the docs are not reachable).
	// 0 is also IGDB's value when it knows nothing, so only the changes are shown: "In attività" would often be wrong
	private static readonly Dictionary<int, string> StatusNames = new()
	{
		[1] = "Chiuso",
		[2] = "Fuso in un'altra azienda",
		[3] = "Rinominato",
	};

	private string? StatusName =>
		_studio is not null && StatusNames.TryGetValue(_studio.StatusId, out var name) ? name : null;

	// joined in code so the "·" separator only appears between the parts that exist
	private string? StudioFacts
	{
		get
		{
			var founded = _studio?.StartDate is DateOnly date ? $"Fondato nel {date.Year}" : null;
			var parts = new[] { CountryName, founded, StatusName }.Where(p => p is not null);
			return parts.Any() ? string.Join(" · ", parts) : null;
		}
	}

	private Studio? _studio;
	private bool _loading;
	private bool _error;
	private bool _aboutExpanded;
	private int _loadedId;
	private CancellationTokenSource? _studioCts;

	private PagedResult<Game>? _games;
	private bool _gamesError;
	private CancellationTokenSource? _gamesCts;

	// ?page=0 or negative typed in the address counts as page 1: a hand-written url never errors
	private int CurrentPage => Math.Max(Page ?? 1, 1);
	private int PageCount
	{
		get
		{
			if (_games is null)
				return 0;
			var pageSize = _games.PageSize > 0 ? _games.PageSize : DefaultPageSize;
			return (int)Math.Ceiling(_games.Total / (double)pageSize);
		}
	}

	// Rating 0 means "no rating" (IGDB has none): counting it would drag the average down
	private List<Game> RatedGames => _games?.Items?.Where(g => g.Rating > 0).ToList() ?? [];
	private double AverageRating => RatedGames.Count > 0 ? RatedGames.Average(g => g.Rating) : 0;

	private bool IsAboutLong => _studio?.About?.Length > AboutPreviewLength;
	// cut at the last space before the limit, so a word is never split in half
	private string AboutText
	{
		get
		{
			var about = _studio?.About ?? "";
			if (!IsAboutLong || _aboutExpanded)
				return about;

			var cut = about.LastIndexOf(' ', AboutPreviewLength);
			if (cut < 0)
				cut = AboutPreviewLength;
			return about[..cut] + "…";
		}
	}

	private static string GamesWord(int count) => count == 1
		? "1 gioco"
		: $"{count.ToString("N0", ItalianCulture)} giochi";

	// a new studio reloads everything; a new page reloads only the games, the studio did not change
	protected override async Task OnParametersSetAsync()
	{
		if (Id != _loadedId)
		{
			_loadedId = Id;
			await Task.WhenAll(LoadStudioAsync(), LoadGamesAsync());
		}
		else
		{
			await LoadGamesAsync();
		}
	}

	private async Task LoadStudioAsync()
	{
		_studioCts?.Cancel();
		_studioCts?.Dispose();
		_studioCts = new CancellationTokenSource();
		var token = _studioCts.Token;
		_loading = true;
		_error = false;
		_studio = null;
		_aboutExpanded = false;
		try
		{
			var studio = await Api.GetStudioAsync(Id, token);
			if (token.IsCancellationRequested)
				return;
			_studio = studio;
		}
		catch (ApiException)
		{
			if (token.IsCancellationRequested)
				return;
			_error = true;
		}
		catch (OperationCanceledException) when (token.IsCancellationRequested)
		{
			return;
		}
		_loading = false;
		// the studio can arrive before the games: show it now instead of waiting for the other call
		StateHasChanged();
	}

	private async Task LoadGamesAsync()
	{
		_gamesCts?.Cancel();
		_gamesCts?.Dispose();
		_gamesCts = new CancellationTokenSource();
		var token = _gamesCts.Token;
		_gamesError = false;
		_games = null;
		try
		{
			var games = await Api.GetStudioGamesAsync(Id, CurrentPage, token);
			if (token.IsCancellationRequested)
				return;
			_games = games;
		}
		catch (ApiException)
		{
			if (token.IsCancellationRequested)
				return;
			_gamesError = true;
		}
		catch (OperationCanceledException) when (token.IsCancellationRequested)
		{
			return;
		}
		StateHasChanged();
	}

	// page 1 stays out of the address, as in the search: with or without ?page=1 it is the same page
	private async Task OnPageChanged(int page)
	{
		Navigate(new Dictionary<string, object?> { ["page"] = page == 1 ? null : page });
		await JS.InvokeVoidAsync("scrollTo", 0, 0);
	}

	// only the address changes and OnParametersSetAsync reloads the games: this way the browser Back button works
	private void Navigate(Dictionary<string, object?> changes)
	{
		Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(changes));
	}

	public void Dispose()
	{
		_studioCts?.Cancel();
		_studioCts?.Dispose();
		_gamesCts?.Cancel();
		_gamesCts?.Dispose();
	}
}

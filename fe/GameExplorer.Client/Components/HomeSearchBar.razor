@inject NavigationManager Navigation
@inject SearchFocusService SearchFocus
@implements IDisposable

<div class="search-bar-sticky">
	<div class="search-box">
		<MudTextField
			@bind-Value="_query"
			Immediate="true"
			OnKeyDown="OnSearchKeyDown"
			Placeholder="Cerca un gioco..."
			Variant="Variant.Outlined"
			Adornment="Adornment.End"
			AdornmentIcon="@Icons.Material.Filled.Search"
			OnAdornmentClick="Search"
			AdornmentAriaLabel="Cerca"
			@ref="_searchField"
		/>
	</div>
</div>

@code {
	private string? _query;
	private MudTextField<string>? _searchField;

	private void Search()
	{
		if (string.IsNullOrWhiteSpace(_query))
			return ;
		Navigation.NavigateTo($"search?q={Uri.EscapeDataString(_query.Trim())}");
	}

	private void OnSearchKeyDown(KeyboardEventArgs e)
	{
		if (e.Key == "Enter")
			Search();
	}

	private async Task FocusSearchFieldAsync()
	{
		if (_searchField is not null)
			await _searchField.FocusAsync();
	}
	protected override void OnInitialized()
	{
		SearchFocus.Requested += FocusSearchFieldAsync;
	}

	public void Dispose()
	{
		SearchFocus.Requested -= FocusSearchFieldAsync;
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender && SearchFocus.ConsumePending())
			await FocusSearchFieldAsync();
	}
}

@using System.Globalization

<a href="games/@Game.Id" class="game-card" tabindex="@(IsClone ? "-1" : null)">
	<MudCard Elevation="2" Class="full-height">
		@if (Game.Image?.Url is not null)
		{
			<img src="@Game.Image.Url" alt="@Game.Name" loading="lazy" class="cover" />
		}
		else
		{
			<div class="cover cover-placeholder">
				<MudIcon Icon="@Icons.Material.Filled.ImageNotSupported" Size="Size.Large" />
			</div>
		}
		<MudCardContent>
			<MudText Typo="Typo.subtitle1" Class="game-name">
				@Game.Name
			</MudText>
			@if (HighlightDate)
			{
				<MudText Typo="Typo.h6" Color="Color.Primary" HtmlTag="p">
					@ReleaseDateText
				</MudText>
			}
			else
			{
				<MudText Typo="Typo.body2" Class="mud-text-secondary">
					@ReleaseDateText
				</MudText>
			}
			@if (Game.Rating > 0)
			{
				<MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
					<MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" Color="Color.Warning" />
					<MudText Typo="Typo.body2">
						@Game.Rating.ToString("0.0 '/ 100'", CultureInfo.GetCultureInfo("it-IT"))
					</MudText>
				</MudStack>
			}
			else
			{
				<MudText Typo="Typo.body2" Class="mud-text-secondary">
					Nessun voto
				</MudText>
			}
			@if (PlatformFamilies.Count > 0)
			{
				@* names instead of icons: the icons looked almost the same and phones have no tooltip.
				   Wrap: with many platforms the names go to a new line instead of widening the card *@
				<MudStack Row="true" Spacing="1" Class="mt-2" Wrap="Wrap.Wrap">
					@foreach (var family in PlatformFamilies)
					{
						<span class="platform-tag">@family</span>
					}
				</MudStack>
			}
		</MudCardContent>
	</MudCard>
</a>

@code {
	[Parameter, EditorRequired]
	public Game Game { get; set; } = default!;

	[Parameter]
	public bool HighlightDate { get; set; }

	// a copy in the GameSection carousel is visible and clickable, but Tab must skip it (tabindex -1) or every game is reached twice
	[Parameter]
	public bool IsClone { get; set; }

	private static readonly string[] PcSlugs = ["win", "mac", "linux"];
	private static readonly string[] NintendoSlugs = ["switch", "switch-2", "wii", "wiiu", "3ds", "nds", "ngc", "n64", "nes", "snes", "gb", "gba", "gbc"];
	private static readonly string[] MobileSlugs = ["ios", "android"];

	private string ReleaseDateText => Game.ReleaseDate is null
		? "Data da annunciare"
		: Game.ReleaseDate.Value.ToString("d MMM yyyy", CultureInfo.GetCultureInfo("it-IT"));

	// a fixed order, the same on every card: following each game's platform order made the cards hard to compare
	private static readonly string[] FamilyOrder = ["PC", "PlayStation", "Xbox", "Nintendo", "Mobile", "Altro"];

	private List<string> PlatformFamilies => Game.Platforms
		.Select(platform => GetPlatformFamily(platform.Slug))
		.Distinct()
		.OrderBy(family => Array.IndexOf(FamilyOrder, family))
		.ToList();

	private static string GetPlatformFamily(string slug)
	{
		if (PcSlugs.Contains(slug))
			return "PC";
		if (slug.StartsWith("ps"))
			return "PlayStation";
		if (slug.StartsWith("xbox") || slug.StartsWith("series-x-s"))
			return "Xbox";
		if (NintendoSlugs.Contains(slug))
			return "Nintendo";
		if (MobileSlugs.Contains(slug))
			return "Mobile";
		return "Altro";
	}
}

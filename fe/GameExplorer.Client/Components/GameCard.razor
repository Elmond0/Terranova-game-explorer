@using System.Globalization

<a href="games/@Game.Id" class="game-card">
	<MudCard Elevation="2" Class="full-height">
		@if (Game.Image is not null)
		{
			<img src="@Game.Image" alt="@Game.Name" loading="lazy" class="cover" />
		}
		else
		{
			<div class="cover cover-placeholder">
				<MudIcon Icon="@Icons.Material.Filled.ImageNotSupported" Size="Size.Large" />
			</div>
		}
		<MudCardContent>
			<MudText Typo="Typo.subtitle1" Class="game-name">
				@Game.Name
			</MudText>
			@if (HighlightDate)
			{
				<MudText Typo="Typo.h6" Color="Color.Primary">
					@ReleaseDateText
				</MudText>
			}
			else
			{
				<MudText Typo="Typo.body2" Class="mud-text-secondary">
					@ReleaseDateText
				</MudText>
			}
			@if (Game.Rating > 0)
			{
				<MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
					<MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" Color="Color.Warning" />
					<MudText Typo="Typo.body2">
						@Game.Rating.ToString("0.0")
					</MudText>
				</MudStack>
			}
			else
			{
				<MudText Typo="Typo.body2" Class="mud-text-secondary">
					Nessun voto
				</MudText>
			}
			@if (PlatformFamilies.Count > 0)
			{
				<MudStack Row="true" Spacing="1" Class="mt-2">
					@foreach (var family in PlatformFamilies)
					{
						<MudTooltip Text="@family">
							<MudIcon Icon="@GetFamilyIcon(family)" Size="Size.Small" Class="mud-text-secondary" aria-label="@family" />
						</MudTooltip>
					}
				</MudStack>
			}
		</MudCardContent>
	</MudCard>
</a>

@code {
	[Parameter, EditorRequired]
	public Game Game { get; set; } = default!;

	[Parameter]
	public bool HighlightDate { get; set; }

	private string ReleaseDateText => Game.ReleaseDate is null
		? "Data da annunciare"
		: Game.ReleaseDate.Value.ToString("d MMM yyyy", CultureInfo.GetCultureInfo("it-IT"));

	private List<string> PlatformFamilies => Game.Platforms
		.Select(platform => GetPlatformFamily(platform.Slug))
		.Distinct()
		.ToList();

	private static string GetPlatformFamily(string slug)
	{
		if (slug.StartsWith("pc"))
			return "PC";
		if (slug.StartsWith("playstation"))
			return "PlayStation";
		if (slug.StartsWith("xbox"))
			return "Xbox";
		if (slug.StartsWith("nintendo"))
			return "Nintendo";
		if (slug.StartsWith("ios") || slug.StartsWith("android"))
			return "Mobile";
		return "Altro";
	}

	private static string GetFamilyIcon(string family)
	{
		if (family == "PC")
			return Icons.Material.Filled.DesktopWindows;
		if (family == "PlayStation")
			return Icons.Material.Filled.SportsEsports;
		if (family == "Xbox")
			return Icons.Material.Filled.VideogameAsset;
		if (family == "Nintendo")
			return Icons.Material.Filled.Gamepad;
		if (family == "Mobile")
			return Icons.Material.Filled.PhoneAndroid;
		return Icons.Material.Filled.Games;
	}
}

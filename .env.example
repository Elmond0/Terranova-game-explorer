# Copy to .env and fill in: cp .env.example .env — never commit .env.
# Passwords apply only on the FIRST start of the volume: to change them run
# docker compose down -v (deletes the local database data).

# PostgreSQL admin (superuser): maintenance and backups, not the backend
POSTGRES_USER=terranova
# Required. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Database name
POSTGRES_DB=terranova
# Port on your machine (127.0.0.1 only): change it if 5432 is already in use
POSTGRES_PORT=5432

# Migrations and restore user (not a superuser, owner of the database)
APP_DB_USER=terranova_app
# Required. Generate with: openssl rand -hex 24
APP_DB_PASSWORD=

# Runtime user of the backend: reads and writes rows, cannot change tables
API_DB_USER=terranova_api
# Required. Generate with: openssl rand -hex 24
API_DB_PASSWORD=

# Adminer (only with: docker compose --profile tools up -d)
ADMINER_PORT=8080

# Backend connection string (in .NET User Secrets, not here):
#   from your machine:      Host=localhost;Port=5432;Database=terranova;Username=terranova_api;Password=...
#   from the api container: Host=db;Port=5432;Database=terranova;Username=terranova_api;Password=...
